@model Utulek1.Application.ViewModels.AdoptionDetailViewModel

@{
    ViewData["Title"] = Model.Animal.Name;
}

<div class="container mt-5">

    <a asp-action="Index" class="btn btn-outline-secondary mb-4">&larr; Zpět na nabídku</a>

    <div class="row">
        <div class="col-md-6 mb-4">
            @if (Model.Animal.Photos != null && Model.Animal.Photos.Any())
            {
                <img src="@Model.Animal.Photos.First().PhotoURL" class="img-fluid rounded shadow w-100" alt="@Model.Animal.Name" style="object-fit: cover; max-height: 500px;">

                @if (Model.Animal.Photos.Count > 1)
                {
                    <div class="d-flex gap-2 mt-2 overflow-auto">
                        @foreach (var photo in Model.Animal.Photos.Skip(1))
                        {
                            <img src="@photo.PhotoURL" class="rounded border" style="width: 80px; height: 80px; object-fit: cover;">
                        }
                    </div>
                }
            }
            else
            {
                <img src="/img/Carousel/Placeholder.png" class="img-fluid rounded shadow w-100" alt="Bez fotky">
            }
        </div>

        <div class="col-md-6">
            <h1 class="display-4 fw-bold">@Model.Animal.Name</h1>
            <p class="text-muted fs-5">@Model.Animal.Breed?.Name | @Model.Animal.Species?.Name</p>

            <hr />

            <dl class="row fs-5">
                <dt class="col-sm-4">Věk:</dt>
                <dd class="col-sm-8">@Model.Animal.Age let</dd>

                
                <dt class="col-sm-4">Datum příchodu:</dt>
                <dd class="col-sm-8">@Model.Animal.ArrivalDate.ToString("d. M. yyyy")</dd>

                <dt class="col-sm-4">Status:</dt>
                <dd class="col-sm-8">
                    @if (Model.Animal.Status == "K adopci")
                    {
                        <span class="badge bg-success">K adopci</span>
                    }
                    else
                    {

                        <span class="badge bg-secondary">@Model.Animal.Status</span>
                    }
                </dd>
            </dl>

            <hr />

            <div class="mt-4">
                @if (User.Identity.IsAuthenticated)
                {
                    @if (Model.HasActiveRequest)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-info-circle"></i> O toto zvíře jste již požádal(a).
                            <a asp-action="MyAdoptions" class="alert-link">Zobrazit stav žádosti</a>
                        </div>
                    }
                    else if (Model.Animal.Status == "K adopci")
                    {
                        <form asp-action="CreateRequest" method="post">
                            <input type="hidden" name="animalId" value="@Model.Animal.AnimalID" />
                            <button type="submit" class="btn btn-primary btn-lg w-100 p-3 shadow-sm">
                                <i class="bi bi-heart-fill me-2"></i> Mám vážný zájem
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg w-100" disabled>Zvíře není k dispozici</button>
                    }
                }
                else
                {
                    <div class="alert alert-light border text-center">
                        Pro adopci se musíte <a asp-controller="Account" asp-action="Login" class="fw-bold">přihlásit</a>.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <h3>O mně</h3>
            <div class="p-4 bg-light rounded border">
                <p class="fs-5" style="white-space: pre-line;">@Model.Animal.Description</p>
            </div>
        </div>
    </div>
</div>