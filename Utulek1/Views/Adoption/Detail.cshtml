@model Utulek1.Application.ViewModels.AdoptionDetailViewModel

@{
    ViewData["Title"] = Model.Animal.Name;
    // Získáme URL první fotky (nebo placeholder), abychom ji dali jako výchozí
    var mainPhotoUrl = Model.Animal.Photos != null && Model.Animal.Photos.Any()
                       ? Model.Animal.Photos.First().PhotoURL
                       : "/img/Carousel/Placeholder.png";
}

<div class="container mt-5">

    <a asp-action="Index" class="btn btn-outline-secondary mb-4">&larr; Zpět na nabídku</a>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="border rounded overflow-hidden shadow-sm mb-2">
                <img id="mainImage" src="@mainPhotoUrl"
                     class="img-fluid w-100"
                     alt="@Model.Animal.Name"
                     style="height: 450px; object-fit: cover; transition: opacity 0.3s;">
            </div>

            @if (Model.Animal.Photos != null && Model.Animal.Photos.Count > 1)
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var photo in Model.Animal.Photos)
                    {
                        <img src="@photo.PhotoURL"
                             onclick="changeImage(this.src)"
                             class="rounded border thumbnail-hover"
                             style="width: 80px; height: 80px; object-fit: cover; cursor: pointer;"
                             alt="Náhled" />
                    }
                </div>
            }
        </div>

        <div class="col-md-6">
            <h1 class="display-4 fw-bold">@Model.Animal.Name</h1>

            <p class="text-muted fs-5 mb-4">
                <span class="badge bg-info text-dark">@Model.Animal.Species?.Name</span>
                @Model.Animal.Breed?.Name
            </p>

            <div class="p-4 bg-light rounded border mb-4">
                <dl class="row fs-5 mb-0">
                    
                    <dt class="col-sm-5">Věk:</dt>
                    <dd class="col-sm-7">@Model.Animal.Age let</dd>


                    <dt class="col-sm-5">Datum příchodu:</dt>
                    <dd class="col-sm-7">@Model.Animal.ArrivalDate.ToString("d. M. yyyy")</dd>

                    <dt class="col-sm-5">Status:</dt>
                    <dd class="col-sm-7">
                        @if (Model.Animal.Status == "K adopci")
                        {
                            <span class="badge bg-success">K adopci</span>
                        }
                        else
                        {

                            <span class="badge bg-secondary">@Model.Animal.Status</span>
                        }
                    </dd>
                </dl>
            </div>

            <div>
                @if (User.Identity.IsAuthenticated)
                {
                    @if (Model.HasActiveRequest)
                    {
                        <div class="alert alert-warning border-warning">
                            <h5 class="alert-heading"><i class="bi bi-clock-history"></i> Žádost odeslána</h5>
                            <p class="mb-0">O toto zvíře jste již požádal(a). Vyčkejte na schválení.</p>
                            <hr>
                            <a asp-action="MyAdoptions" class="btn btn-outline-warning text-dark w-100">Přejít na Moje adopce</a>
                        </div>
                    }
                    else if (Model.Animal.Status == "K adopci")
                    {
                        <form asp-action="CreateRequest" method="post">
                            <input type="hidden" name="animalId" value="@Model.Animal.AnimalID" />
                            <button type="submit" class="btn btn-primary btn-lg w-100 p-3 shadow fw-bold">
                                <i class="bi bi-heart-fill me-2"></i> Mám vážný zájem
                            </button>
                        </form>
                        <p class="text-muted text-center mt-2 small">Kliknutím odešlete nezávaznou žádost o rezervaci.</p>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg w-100" disabled>Zvíře je momentálně nedostupné</button>
                    }
                }
                else
                {
                    <div class="alert alert-secondary text-center">
                        <i class="bi bi-lock-fill display-6 d-block mb-2"></i>
                        Pro adopci se musíte <a asp-controller="Account" asp-action="Login" class="fw-bold link-dark">přihlásit</a>.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <h3>O mně</h3>
            <div class="p-4 bg-light rounded border">
                <p class="fs-5" style="white-space: pre-line;">@Model.Animal.Description</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Jednoduchá funkce pro výměnu obrázku
        function changeImage(src) {
            var mainImage = document.getElementById('mainImage');

            // Efekt prolnutí (volitelné, vypadá to lépe)
            mainImage.style.opacity = 0.5;

            setTimeout(function() {
                mainImage.src = src;
                mainImage.style.opacity = 1;
            }, 150);
        }
    </script>

    <style>
        /* Styl pro hover efekt na miniaturách */
        .thumbnail-hover:hover {
            opacity: 0.8;
            border-color: #0d6efd !important; /* Modrý rámeček bootstrapu */
            border-width: 2px !important;
            transform: scale(1.05);
            transition: all 0.2s;
        }
    </style>
}