@using Utulek1.Application.ViewModels
@using Utulek1.Domain.Entities
@model CarouselAnimalViewModel

@{
    ViewData["Title"] = "Vítejte";
}

@if (Model?.Carousels != null && Model.Carousels.Any())
{
    <div id="mainCarousel" class="carousel slide carousel-fade shadow-lg" data-bs-ride="carousel">

        <div class="carousel-indicators">
            @for (int i = 0; i < Model.Carousels.Count; i++)
            {
                <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="true"></button>
            }
        </div>

        <div class="carousel-inner">
            @for (int i = 0; i < Model.Carousels.Count; i++)
            {
                var item = Model.Carousels[i];
                <div class="carousel-item @(i == 0 ? "active" : "")" data-bs-interval="4000">
                    <img src="@item.ImageSrc" class="d-block w-100 hero-img" alt="@(item.ImageAlt ?? "Útulek")">

                    <div class="carousel-overlay"></div>

                    <div class="carousel-caption d-none d-md-block text-start" style="bottom: 20%; left: 10%;">
                        <h1 class="display-3 fw-bold text-white mb-3 text-shadow">Najděte věrného přítele</h1>
                        <p class="lead text-white mb-4 text-shadow fs-4">Každé zvíře si zaslouží druhou šanci na láskyplný domov.</p>
                        <a asp-controller="Adoption" asp-action="Index" class="btn btn-primary btn-lg px-5 py-3 rounded-pill fw-bold shadow">
                            <i class="bi bi-heart-fill me-2"></i> Chci adoptovat
                        </a>
                    </div>
                </div>
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Předchozí</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Další</span>
        </button>
    </div>
}

<div class="container my-5 py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-5">Proč zvolit adopci?</h2>
        <p class="text-muted fs-5">Adopcí nezískáte jen zvíře, získáte člena rodiny.</p>
    </div>

    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="p-4 h-100 bg-light rounded-4 shadow-sm transition-hover">
                <div class="text-primary mb-3">
                    <i class="bi bi-house-heart-fill display-4"></i>
                </div>
                <h4 class="fw-bold">Domov pro opuštěné</h4>
                <p class="text-muted">Pomáháte zvířatům, která ztratila domov, najít nové bezpečí a lásku.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="p-4 h-100 bg-light rounded-4 shadow-sm transition-hover">
                <div class="text-success mb-3">
                    <i class="bi bi-shield-check display-4"></i>
                </div>
                <h4 class="fw-bold">Veterinární péče</h4>
                <p class="text-muted">Všechna naše zvířata jsou očkovaná, čipovaná a pod veterinárním dohledem.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="p-4 h-100 bg-light rounded-4 shadow-sm transition-hover">
                <div class="text-warning mb-3">
                    <i class="bi bi-emoji-smile-fill display-4"></i>
                </div>
                <h4 class="fw-bold">Vděčný parťák</h4>
                <p class="text-muted">Adoptovaná zvířata často projevují neuvěřitelnou vděčnost a věrnost.</p>
            </div>
        </div>
    </div>
</div>

<div class="bg-primary text-white py-5 mb-0">
    <div class="container text-center py-4">
        <h2 class="display-6 fw-bold mb-3">Jste připraveni změnit život?</h2>
        <p class="fs-5 mb-4 opacity-75">Podívejte se na naše aktuální svěřence a najděte toho pravého.</p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Adoption" asp-action="Index" class="btn btn-light btn-lg px-4 fw-bold text-primary">
                Nabídka zvířat
            </a>
            <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-light btn-lg px-4 fw-bold">
                Kontaktujte nás
            </a>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Nastavení pevné výšky Carouselu */
        .hero-img {
            height: 65vh; /* 65% výšky obrazovky - ideální pro moderní weby */
            object-fit: cover; /* Ořízne fotku tak, aby vyplnila prostor, ale nedeformovala se */
            min-height: 400px; /* Aby to na mobilech nebylo moc úzké */
        }

        /* Tmavý gradient přes fotku, aby byl text čitelný */
        .carousel-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to right, rgba(0,0,0,0.7), rgba(0,0,0,0));
        }

        /* Stín pod textem */
        .text-shadow {
            text-shadow: 2px 2px 4px rgba(0,0,0,0.6);
        }

        /* Efekt při najetí na karty */
        .transition-hover:hover {
            transform: translateY(-5px);
            transition: transform 0.3s ease;
            background-color: #fff !important; /* Změna pozadí na čistě bílou */
        }
    </style>
}