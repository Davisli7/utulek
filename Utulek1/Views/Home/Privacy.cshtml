@{
    ViewData["Title"] = "O nás";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">O nás</h1>
        <p class="lead text-muted">Jsme tým nadšenců, kteří věří, že každé zvíře si zaslouží lásku.</p>
    </div>

    <div class="row mb-5 justify-content-center">
        <div class="col-12 text-center mb-4">
            <h2 class="fw-bold">Náš tým</h2>
            <div class="border-bottom w-25 mx-auto border-primary border-3"></div>
        </div>

        <div class="col-md-5 mb-4">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <div class="mb-3">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                        <i class="bi bi-person-heart display-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold h4">Ing. Anna Nováková</h3>
                <p class="text-primary fw-bold text-uppercase small">Ředitelka útulku</p>
                <p class="text-muted">Anna založila útulek před 10 lety. Stará se o chod organizace a zajišťuje, aby zvířátkům nic nechybělo.</p>
                <div class="mt-auto">
                    <p class="mb-1"><i class="bi bi-envelope-fill text-primary me-2"></i> anna.novakova@utulek-fiktivni.cz</p>
                    <p class="mb-0"><i class="bi bi-telephone-fill text-primary me-2"></i> +420 601 123 456</p>
                </div>
            </div>
        </div>

        <div class="col-md-5 mb-4">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <div class="mb-3">
                    <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                        <i class="bi bi-bandaid display-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold h4">MVDr. Petr Svoboda</h3>
                <p class="text-success fw-bold text-uppercase small">Hlavní veterinář</p>
                <p class="text-muted">Petr je zkušený veterinář s láskou ke psům i kočkám. Dohlíží na zdravotní stav všech našich svěřenců.</p>
                <div class="mt-auto">
                    <p class="mb-1"><i class="bi bi-envelope-fill text-success me-2"></i> petr.svoboda@utulek-fiktivni.cz</p>
                    <p class="mb-0"><i class="bi bi-telephone-fill text-success me-2"></i> +420 702 987 654</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row bg-light rounded-4 p-4 p-lg-5 shadow-sm align-items-center">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <h2 class="fw-bold mb-4">Kde nás najdete?</h2>

            <div class="d-flex mb-3">
                <div class="me-3 text-primary"><i class="bi bi-geo-alt-fill fs-3"></i></div>
                <div>
                    <h5 class="fw-bold mb-1">Adresa útulku</h5>
                    <p class="text-muted mb-0">U Lesíka 42<br>123 00 Kocourkov<br>Česká republika</p>
                </div>
            </div>

            <div class="d-flex mb-3">
                <div class="me-3 text-primary"><i class="bi bi-clock-fill fs-3"></i></div>
                <div>
                    <h5 class="fw-bold mb-1">Otevírací doba pro veřejnost</h5>
                    <table class="table table-borderless table-sm text-muted mb-0">
                        <tr><td>Pondělí - Pátek:</td> <td>8:00 - 17:00</td></tr>
                        <tr><td>Víkendy:</td> <td>9:00 - 14:00</td></tr>
                    </table>
                </div>
            </div>

            <div class="d-flex">
                <div class="me-3 text-primary"><i class="bi bi-info-circle-fill fs-3"></i></div>
                <div>
                    <h5 class="fw-bold mb-1">Fakturační údaje</h5>
                    <p class="text-muted mb-0">IČO: 12345678<br>Číslo účtu: 123456789/0100</p>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="ratio ratio-4x3 rounded shadow overflow-hidden">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2564.385686002958!2d14.42076!3d50.0755!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTDCsDA0JzMxLjgiTiAxNMKwMjUnMTQuNyJF!5e0!3m2!1scs!2scz!4v1620000000000!5m2!1scs!2scz"
                        style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
        </div>
    </div>
</div>