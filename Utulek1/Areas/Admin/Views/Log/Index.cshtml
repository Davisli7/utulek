@using Utulek1.Domain.Entities
@model IEnumerable<SystemLog>

@{
    ViewData["Title"] = "Systémové logy";
}

<div class="container-fluid">
    <h1 class="mb-4">Systémové logy (Audit)</h1>

    <form method="get" asp-action="Index" class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text" name="searchTerm" value="@ViewBag.CurrentSearchTerm" class="form-control" placeholder="Hledat ve zprávě...">
        </div>
        <div class="col-md-3">
            <select name="level" class="form-select">
                <!- Tady je ten trik s podmínkou ->
                <option value="All" selected="@(ViewBag.CurrentLevel == "All" ? "selected" : null)">Všechny úrovně</option>
                <option value="Information" selected="@(ViewBag.CurrentLevel == "Information" ? "selected" : null)">Information</option>
                <option value="Warning" selected="@(ViewBag.CurrentLevel == "Warning" ? "selected" : null)">Warning</option>
                <option value="Error" selected="@(ViewBag.CurrentLevel == "Error" ? "selected" : null)">Error</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filtrovat</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Zrušit filtr</a>
        </div>
    </form>

    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Čas</th>
                        <th>Level</th>
                        <th>Zpráva</th>
                        <th>Chyba (Exception)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        string rowClass = "";
                        if (log.Level == "Error" || log.Level == "Fatal") rowClass = "table-danger";
                        else if (log.Level == "Warning") rowClass = "table-warning";

                        <tr class="@rowClass">
                            <td style="white-space:nowrap;">@log.TimeStamp.ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td>
                                <span class="badge @(log.Level == "Error" ? "bg-danger" : (log.Level == "Warning" ? "bg-warning text-dark" : "bg-info text-dark"))">
                                    @log.Level
                                </span>
                            </td>
                            <td>@log.Message</td>
                            <td class="text-danger small">@log.Exception</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>