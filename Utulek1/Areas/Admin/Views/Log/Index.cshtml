@using Utulek1.Domain.Entities
@model IEnumerable<SystemLog>

@{
    ViewData["Title"] = "Systémové logy";
}

<div class="container-fluid">
    <h1 class="mb-4">Systémové logy (Audit)</h1>

    <div class="card shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-auto fw-bold">Zobrazit úroveň:</div>
                <div class="col-auto">
                    <select name="levelFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="All" selected="@(ViewBag.CurrentLevelFilter == "All")">Všechno</option>
                        <option value="Information" selected="@(ViewBag.CurrentLevelFilter == "Information")">Information</option>
                        <option value="Warning" selected="@(ViewBag.CurrentLevelFilter == "Warning")">Warning</option>
                        <option value="Error" selected="@(ViewBag.CurrentLevelFilter == "Error")">Error</option>
                    </select>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Čas</th>
                        <th>Level</th>
                        <th>Zpráva</th>
                        <th>Chyba (Exception)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        // Obarvení řádků podle závažnosti
                        string rowClass = "";
                        if (log.Level == "Error" || log.Level == "Fatal") rowClass = "table-danger";
                        else if (log.Level == "Warning") rowClass = "table-warning";

                        <tr class="@rowClass">
                            <td style="white-space:nowrap;">@log.TimeStamp.ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td>
                                <span class="badge @(log.Level == "Error" ? "bg-danger" : (log.Level == "Warning" ? "bg-warning text-dark" : "bg-info text-dark"))">
                                    @log.Level
                                </span>
                            </td>
                            <td>@log.Message</td>
                            <td class="text-danger small">@log.Exception</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>