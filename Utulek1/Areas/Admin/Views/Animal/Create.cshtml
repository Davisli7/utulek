@using Utulek1.Domain.Entities
@model Animal

@{
    ViewData["Title"] = "Animal - Create";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Age" class="form-label"></label>
        <input asp-for="Age" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Breed" class="form-label"></label>
        <input asp-for="Breed" class="form-control" />
        <span asp-validation-for="Breed" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AnimalID" class="form-label"></label>
        <input asp-for="AnimalID" class="form-control" />
        <span asp-validation-for="AnimalID" class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="ArrivalDate" class="form-label"></label>
        <input asp-for="ArrivalDate" class="form-control" />
        <span asp-validation-for="ArrivalDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <input asp-for="Status" class="form-control" />
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SpeciesID" class="form-label"></label>
        <input asp-for="SpeciesID" class="form-control" />
        <span asp-validation-for="SpeciesID" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Photos" class="form-label"></label>
        <input asp-for="Photos" class="form-control" />
        <span asp-validation-for="Photos" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AdoptionRequests" class="form-label"></label>
        <input asp-for="AdoptionRequests" class="form-control" />
        <span asp-validation-for="AdoptionRequests" class="text-danger"></span>
    </div>







    <button type="submit" class="btn btn-primary">Submit</button>
</form>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}