@using Utulek1.Domain.Entities
@model Animal

@{
    ViewData["Title"] = "Animal - Create";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Jméno</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Age" class="form-label">Věk</label>
                <input asp-for="Age" class="form-control" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Popis</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="BreedID" class="form-label">Plemeno</label>
                <select asp-for="BreedID" class="form-select" asp-items="ViewBag.BreedList">
                    <option value="">-- Vyberte plemeno --</option>
                </select>
                <span asp-validation-for="BreedID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SpeciesID" class="form-label">Druh</label>
                <select asp-for="SpeciesID" class="form-select" asp-items="ViewBag.SpeciesList">
                    <option value="">-- Vyberte druh --</option>
                </select>
                <span asp-validation-for="SpeciesID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" class="form-select">
                    <option value="K adopci">K adopci</option>
                    <option value="Zarezervováno">Zarezervováno</option>
                    <option value="Adoptováno">Adoptováno</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ArrivalDate" class="form-label">Datum příchodu</label>
                <input asp-for="ArrivalDate" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="ArrivalDate" class="text-danger"></span>
            </div>

            <div class="mb-3 border p-3 bg-light rounded">
                <label class="form-label fw-bold">Nahrát fotky</label>
                <input type="file" name="uploadedFiles" class="form-control" multiple accept="image/*" />
                <small class="text-muted">Můžete vybrat více obrázků najednou (jpg, png, webp,  max 10MB).</small>

                <span class="text-danger field-validation-valid" data-valmsg-for="uploadedFiles" data-valmsg-replace="true"></span>
                @Html.ValidationMessage("uploadedFiles", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary btn-lg">Vytvořit záznam</button>
        <a asp-action="Select" class="btn btn-secondary btn-lg ms-2">Zpět na seznam</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            // 1. Načteme si data z C# do JavaScriptové proměnné
            // Serializace převede C# List<Breed> na JSON pole objektů
            var allBreeds = @Json.Serialize(ViewBag.AllBreeds);

            // Uložíme si odkazy na elementy (selecty)
            var $speciesSelect = $("#SpeciesID");
            var $breedSelect = $("#BreedID");

            // Uložíme si původní html obsah selectu pro plemena (abychom tam mohli vracet defaultní možnost)
            var defaultBreedOption = '<option value="">-- Vyberte plemeno --</option>';

            // --- FUNKCE A: Když se změní DRUH -> Vyfiltrovat PLEMENA ---
            $speciesSelect.change(function () {
                var selectedSpeciesId = $(this).val();

                // Uložíme si aktuálně vybrané plemeno (pokud to jde), abychom ho neztratili při překreslení
                var currentBreedId = $breedSelect.val();

                // Vyprázdníme seznam plemen a dáme tam zpět výchozí možnost
                $breedSelect.empty();
                $breedSelect.append(defaultBreedOption);

                // Projdeme všechna plemena a přidáme jen ta, která odpovídají vybranému druhu
                $.each(allBreeds, function (index, breed) {
                    // Logika:
                    // 1. Pokud není vybrán žádný druh (selectedSpeciesId je prázdné), neukazujeme nic (nebo všechna, záleží na preferenci).
                    //    Zde: Pokud není vybrán druh, ukážeme všechna (aby uživatel mohl začít výběrem plemene).
                    // 2. Pokud ID druhu souhlasí.
                    // POZOR: V JSONu jsou názvy vlastností malým písmem (camelCase) -> breed.speciesID

                    if (!selectedSpeciesId || breed.speciesID == selectedSpeciesId) {
                        $breedSelect.append('<option value="' + breed.breedID + '">' + breed.name + '</option>');
                    }
                });

                // Pokud původně vybrané plemeno stále existuje v novém seznamu (tzn. patří k vybranému druhu), znovu ho vybereme.
                // Pokud neexistuje (uživatel změnil Psa na Kočku, ale měl vybraného Jezevčíka), výběr se zruší (zůstane "Vyberte plemeno").
                if (currentBreedId) {
                    // Zkontrolujeme, jestli taková option v selectu existuje
                    if ($breedSelect.find("option[value='" + currentBreedId + "']").length > 0) {
                        $breedSelect.val(currentBreedId);
                    }
                }
            });


            // --- FUNKCE B: Když se změní PLEMENO -> Automaticky nastavit DRUH ---
            $breedSelect.change(function () {
                var selectedBreedId = $(this).val();

                if (selectedBreedId) {
                    // Najdeme plemeno v našem seznamu dat
                    // (používáme == místo ===, protože hodnota ze selectu je string, ale v JSONu může být číslo)
                    var selectedBreed = allBreeds.find(b => b.breedID == selectedBreedId);

                    if (selectedBreed) {
                        // Získáme aktuální hodnotu druhu
                        var currentSpeciesId = $speciesSelect.val();

                        // Pokud se druh liší od toho, co má plemeno, změníme ho
                        if (currentSpeciesId != selectedBreed.speciesID) {
                            $speciesSelect.val(selectedBreed.speciesID);

                            // DŮLEŽITÉ: Protože jsme programově změnili Druh, musíme zavolat 'change' i na něm,
                            // aby se případně aktualizovaly další věci (nebo aby se znovu "pročistil" seznam plemen,
                            // i když v tomto směru to není striktně nutné, udržuje to konzistenci).

                            // Ale pozor: Pokud zavoláme $speciesSelect.change(), ta funkce výše (Funkce A)
                            // nám překreslí seznam plemen. Musíme zajistit, aby se nám tam to naše plemeno udrželo.
                            // Funkce A už má logiku pro zachování 'currentBreedId', takže by to mělo projít hladce.

                            $speciesSelect.trigger('change');

                            // Pro jistotu znovu nastavíme plemeno (kdyby ho trigger smazal)
                            $breedSelect.val(selectedBreedId);
                        }
                    }
                }
            });

            // --- INICIALIZACE ---
            // Pokud stránku načítáme a už je něco vybráno (např. při Editaci nebo chybě validace),
            // chceme spustit filtraci, aby seznam plemen odpovídal druhu.
            if ($speciesSelect.val()) {
                // Spustíme filtraci, ale nechceme ztratit vybrané plemeno (pokud ho server poslal)
                $speciesSelect.trigger('change');
            }
        });
    </script>
}
