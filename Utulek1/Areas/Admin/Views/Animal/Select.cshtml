@model IList<Animal>

@{
    ViewData["Title"] = "Animal Administration";   
}
<h1>@ViewData["Title"]</h1>

<a asp-action="Create">Create Product</a>

@{
    if (Model != null && Model.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">@nameof(Animal.AnimalID)</th>
                    <th scope="col">@nameof(Animal.Name)</th>
                    <th scope="col">@nameof(Animal.Description)</th>
                    <th scope="col">@nameof(Animal.Status)</th>
                    <th scope="col">@nameof(Animal.Photos)</th>
                </tr>
            </thead>
            <tbody>

                @for (int i = 0; i < Model.Count; ++i)
                {
                    Animal animal = Model[i];
                    <tr>
                        <th scope="row">@animal.AnimalID</th>
                        <td>@animal.Name</td>
                        <td>@animal.Description</td>
                        <td>@animal.Status</td>
                        <td>@animal.Photos</td>
                    </tr>
                }

            </tbody>
        </table>
    }
    else
    {
        <p>Animal table is empty!</p>
    }
}
